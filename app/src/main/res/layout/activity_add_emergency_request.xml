<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Emergency Request"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp" />

    <!-- Emergency Request Title -->
    <EditText
        android:id="@+id/etRequestTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Title of Emergency Request"
        android:padding="12dp"
        android:textSize="16sp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="12dp"/>

    <!-- Description -->
    <EditText
        android:id="@+id/etRequestDescription"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="Describe the emergency"
        android:padding="12dp"
        android:textSize="16sp"
        android:background="@android:drawable/edit_text"
        android:minLines="4"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp" />

    <!-- ProgressBar (Initially Hidden) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnSubmitRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Request"
        android:padding="12dp"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/buttonColor"
        app:cornerRadius="8dp"/>
</LinearLayout>
