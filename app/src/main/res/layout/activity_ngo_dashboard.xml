<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/backgroundColor">

    <!-- NGO Details Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNgoDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/cardBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNgoDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ngo_name_id"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primaryTextColor"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnPitchAid"
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="Add Request"
            android:textSize="18sp"
            android:backgroundTint="@color/buttonColor"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnManageEvents"
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="Add Event"
            android:textSize="18sp"
            android:backgroundTint="@color/buttonColor"
            android:textColor="@color/white"
            android:padding="12dp" />
    </LinearLayout>

    <!-- Volunteer Updates Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/cardBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVolunteerUpdates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading volunteer updates..."
                android:textSize="16sp"
                android:padding="10dp"
                android:textStyle="bold"
                android:background="#F8F8F8"
                android:textColor="#000000" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Push BottomNavigationView to Bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/icon_color"
        app:itemTextColor="@color/icon_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/ngo_bottom_nav_menu" />

</LinearLayout>
