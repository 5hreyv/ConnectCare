<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/backgroundColor">

    <!-- Title -->
    <TextView
        android:id="@+id/tvDonationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make a Donation"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:paddingBottom="10dp"/>

    <!-- Donation Form Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDonationTitle"
        android:layout_above="@id/bottom_navigation"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center_horizontal">

        <!-- NGO ID Input -->
        <EditText
            android:id="@+id/etNgoId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter NGO ID"
            android:inputType="text"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginTop="10dp"/>

        <!-- Donation Type Dropdown -->
        <Spinner
            android:id="@+id/spinnerDonationType"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"/>

        <!-- Amount Input -->
        <EditText
            android:id="@+id/etAmountOrItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter amount or item details"
            android:inputType="text"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginTop="10dp"/>

        <!-- Donation Note -->
        <EditText
            android:id="@+id/etDonationNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Optional: Add a message"
            android:inputType="text"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginTop="10dp"/>

        <!-- Donate Button -->
        <Button
            android:id="@+id/btnDonate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Donate Now"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnGooglePay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@android:color/holo_green_dark"
            android:text="Donate with Google Pay"
            android:textColor="@android:color/white" />
    </LinearLayout>


    <!-- Bottom Navigation (Fixed at Bottom) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_nav_menu"
        android:background="@color/white"/>
</RelativeLayout>